  "spacing": {
    "named": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "xxl": 48
    },
    "scale": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "10": 40,
      "12": 48,
      "0.5": 2,
      "0.75": 3,
      "1.5": 6,
      "1.75": 7,
      "2.5": 10,
      "3.5": 14,
      "4.5": 18,
      "8.5": 34
    }
  },
  "radius": {
    "xs": 5,
    "sm": 8,
    "control": 10,
    "md": 12,
    "lg": 16,
    "xl": 18,
    "card": 20,
    "sheet": 24,
    "pill": 999,
    "item": 9,
    "menu": 14
  },
  "webRadius": [
    "item",
    "control",
    "menu"
  ],
  "tracking": {
    "caps": "0.06em",
    "heading": "-0.025em"
  },
  "shadow": {
    "sm": {
      "color": "rose500",
      "opacity": 0.12,
      "radius": 10,
      "offsetY": 4,
      "elevation": 2
    },
    "md": {
      "color": "rose500",
      "opacity": 0.3,
      "radius": 20,
      "offsetY": 8,
      "elevation": 4
    },
    "lg": {
      "color": "rose500",
      "opacity": 0.25,
      "radius": 40,
      "offsetY": 20,
      "elevation": 8
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "240ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)",
    "native": {
      "durations": { "quick": 120, "base": 180, "slow": 240, "enter": 320, "reveal": 480 },
      "easing": { "standard": [0.4, 0, 0.2, 1], "exit": [0.4, 0, 1, 1] },
      "springs": {
        "press": { "stiffness": 400, "damping": 28, "mass": 1 },
        "settle": { "stiffness": 300, "damping": 24, "mass": 1 }
      },
      "stagger": { "stepMs": 36, "maxItems": 8 }
    }
  }
}
