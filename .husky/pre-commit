#!/usr/bin/env sh
# Pre-commit gate: lint changed apps only (warnings pass, errors block)

changed=$(git diff --cached --name-only --diff-filter=ACMR)

if echo "$changed" | grep -q '^admin/'; then
  (cd admin && npm run lint && npm run lint:arch) || exit 1
fi

if echo "$changed" | grep -q '^mobile/'; then
  (cd mobile && npm run lint) || exit 1
fi

if echo "$changed" | grep -q '^backend/'; then
  if [ -x backend/.venv/bin/ruff ]; then
    (cd backend && .venv/bin/ruff check . && .venv/bin/ruff format --check .) || exit 1
  else
    echo "pre-commit: backend/.venv/bin/ruff missing — run backend deps install to enable the Python lint gate" >&2
  fi
fi
