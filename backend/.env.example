DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/art_circle
TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/art_circle_test
JWT_SECRET=dev-secret-MUST-BE-CHANGED-min-32-bytes!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DEBUG=true
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# Image storage: fake (no network; dev/tests) or cloudinary
STORAGE_PROVIDER=fake
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CORS origins allowed when DEBUG=false (JSON list) — the admin web app
ADMIN_ORIGINS=["http://localhost:5173"]
# Encrypts stored Aadhaar numbers (Fernet, 32 url-safe base64 bytes). LOSING IT MAKES STORED NUMBERS UNRECOVERABLE — keep a backup.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=

# Deposit payments. Only "mock" exists yet: deposits count as paid with no gateway, and the app
# refuses to start with it unless DEBUG=true.
PAYMENT_PROVIDER=mock
