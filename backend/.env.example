# local | test | staging | production. Defaults to production when unset, so a forgotten value fails safe:
# production refuses console SMS, fake storage and mock payments, and hides the API docs.
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/art_circle
# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-MUST-BE-CHANGED-min-32-bytes!
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# console (logs codes; never in production) or fast2sms
SMS_PROVIDER=console
FAST2SMS_API_KEY=
# Development/staging only: every OTP is this 6-digit code (any number signs in). Refused in production.
# Leave empty unless you want a universal code: with SMS_PROVIDER=console the real codes are printed to the log.
DEV_OTP_CODE=

# Image storage: fake (no network; dev/tests, never in production), cloudinary or r2
STORAGE_PROVIDER=fake
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudflare R2 (S3 API token with Object Read & Write). Two buckets: a public one for photos and a private one
# for identity documents (never public). R2 has no resizing, so every image size is the uploaded original.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
# Public address of R2_BUCKET: its r2.dev link or a custom domain
R2_PUBLIC_URL=

# Push notifications: console (logs pushes; dev/tests, never in production) or expo (Expo push service)
PUSH_PROVIDER=console

# Browser origins allowed by CORS outside local (JSON list): the admin web app
CORS_ORIGINS=["http://localhost:5173,https://art-circle-admin.vercel.app"]
# Host headers the API answers to (JSON list); set to the public API hostnames in production
ALLOWED_HOSTS=["*"]
# Logs are JSON outside local; set LOG_JSON=true/false to force
LOG_LEVEL=INFO

# Encrypts stored Aadhaar numbers (Fernet, 32 url-safe base64 bytes). LOSING IT MAKES STORED NUMBERS UNRECOVERABLE — keep a backup.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENCRYPTION_KEY=

# Booking payments. direct: the customer pays the artist's UPI; the platform records amounts but holds no money.
# mock: marks the deposit paid with no gateway (local/test/staging only). Razorpay arrives in phase 2.
PAYMENT_PROVIDER=direct

# Bearer token for GET /metrics (Prometheus). Required in production.
METRICS_TOKEN=
# Load-balancer/proxy addresses trusted for X-Forwarded-For. Required in production.
FORWARDED_ALLOW_IPS=

# Area search fallback for places that aren't catalog areas: none (catalog areas only) or geoapify.
# The key stays on the server; the app never sees it.
GEOCODER_PROVIDER=none
GEOCODER_API_KEY=
