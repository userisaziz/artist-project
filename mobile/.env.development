# Used by `npx expo start`. No secrets here.
# EXPO_PUBLIC_API_URL is left unset on purpose: dev builds then reach the API running on this Mac at the address
# the phone loaded the bundle from (src/core/api/real-transport.ts), so there are no cold starts or Ohio round trips.
# Start the API with ./dev.sh from the repo root.
# To point a dev build at Render staging instead, uncomment:
# EXPO_PUBLIC_API_URL=https://artist-project.onrender.com
EAS_PROJECT_ID=de1ea573-14b0-4ec3-929f-a7982e93bdfe
