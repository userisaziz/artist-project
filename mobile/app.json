{
  "expo": {
    "name": "Art Circle",
    "slug": "art-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.userisaziz.artcircle"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-image",
      ["expo-image-picker", { "photosPermission": "Atelier uses your photos for your profile picture and portfolio.", "cameraPermission": false, "microphonePermission": false }],
      "./plugins/with-android-autofill-highlight"
    ],
    "scheme": "artcircle",
    "newArchEnabled": true
  }
}
