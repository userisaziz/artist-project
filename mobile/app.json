{
  "expo": {
    "name": "GetReady",
    "slug": "art-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.userisaziz.artcircle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.userisaziz.artcircle"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atelier uses your location to place your studio for nearby clients and to show artists near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier uses your photos for your profile picture and portfolio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-autofill-highlight"
    ],
    "scheme": "artcircle",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de1ea573-14b0-4ec3-929f-a7982e93bdfe"
      }
    },
    "owner": "userisaziz"
  }
}
