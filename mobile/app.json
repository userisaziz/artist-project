{
  "expo": {
    "name": "GetReady",
    "slug": "art-circle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.userisaziz.artcircle"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B64D75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.userisaziz.artcircle",
      "config": {},
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-image",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atelier uses your location to place your studio for nearby clients and to show artists near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Atelier uses your photos for your profile picture and portfolio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-android-autofill-highlight"
    ],
    "scheme": "artcircle",
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de1ea573-14b0-4ec3-929f-a7982e93bdfe"
      }
    },
    "owner": "userisaziz",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/de1ea573-14b0-4ec3-929f-a7982e93bdfe"
    }
  }
}
