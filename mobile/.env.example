# Development: leave EXPO_PUBLIC_API_URL unset and the app calls the API on the machine serving Metro
# (your current LAN IP on a phone, localhost in the browser). Set it only to use another API, and always
# for release builds.
# EXPO_PUBLIC_API_URL=https://api.example.com

# Android map tiles for the Location step's map pin (Google Maps SDK for Android key, restricted to this app's
# package and signing certificate). Read by app.config.ts at build time; not needed on iOS (Apple Maps).
# GOOGLE_MAPS_ANDROID_API_KEY=
